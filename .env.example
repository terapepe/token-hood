# Site settings (X, Telegram, CA, networks, min hold) live in src/hood.config.ts — edit that file on GitHub.
# Only secrets and infrastructure go here.

# --- Public ---
NEXT_PUBLIC_WC_PROJECT_ID=            # https://cloud.walletconnect.com (EVM wallets)
NEXT_PUBLIC_ROOT_DOMAIN=tokenhood.online

# --- Server only ---
ANTHROPIC_API_KEY=                    # required: Claude API key for analysis + generation
ANTHROPIC_MODEL=                      # optional, default claude-sonnet-5-5
RPC_URL_ROBINHOOD=                    # optional private RPCs for balance checks (per network)
RPC_URL_BASE=
RPC_URL_BSC=
RPC_URL_SOLANA=                       # recommended for Solana (public RPC is rate-limited)
BLOCKSCOUT_API_ROBINHOOD=             # optional explorer API override per network
HOOD_POOL_ADDRESSES=                  # optional, comma-separated pool addresses for buy/sell tagging
