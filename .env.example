# --- Public (browser) ---
NEXT_PUBLIC_WC_PROJECT_ID=            # https://cloud.walletconnect.com
NEXT_PUBLIC_HOOD_TOKEN_ADDRESS=       # $HOOD ERC-20 on Robinhood Chain (falls back to lib/hood-info.ts)
NEXT_PUBLIC_HOOD_MIN_HOLD=100000      # $HOOD a wallet must hold to use the AI terminal
NEXT_PUBLIC_RPC_URL=                  # optional, defaults to public Robinhood Chain RPC
NEXT_PUBLIC_SWAP_URL=                 # optional buy link, {ca} = token address (default Uniswap)
NEXT_PUBLIC_ROOT_DOMAIN=tokenhood.online

# --- Server only ---
ANTHROPIC_API_KEY=                    # required: Claude API key for analysis + generation
ANTHROPIC_MODEL=                      # optional, default claude-sonnet-5-5
HOOD_RUNS_PER_HOUR=10                 # per-wallet fair-use limit
RPC_URL=                              # optional server RPC for balance checks
BLOCKSCOUT_API_URL=                   # optional, default https://robinhoodchain.blockscout.com/api/v2
HOOD_POOL_ADDRESSES=                  # optional, comma-separated pool addresses for buy/sell tagging
